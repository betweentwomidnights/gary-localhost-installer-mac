        "XDG_CACHE_HOME": "${XDG_CACHE_HOME}",
        "TMPDIR": "${TMPDIR}"
      },
      "bootstrap": {
        "python_executable": "python3.11",
        "venv_directory": "${APP_SUPPORT_DIR}/venvs/foundation",
        "requirements_file": "${RUNTIME_ROOT}/foundation/requirements.txt",
        "upgrade_build_tools": true,
        "pip_arguments": []
      },
      "log_file": "foundation.log",
      "health_check": {
        "url": "http://127.0.0.1:8015/health",
        "expected_status": 200,
        "interval_seconds": 3,
        "timeout_seconds": 2
      },
      "auto_start": false,
      "restart_on_crash": true,
      "graceful_shutdown_seconds": 8
    }
  ]
}
