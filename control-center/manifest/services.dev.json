{
  "schema_version": 1,
  "app_name": "Gary Localhost Control Center",
  "variables": {
    "PYTHONUNBUFFERED": "1",
    "HF_HOME": "${HOME}/Library/Application Support/GaryLocalhost/cache/huggingface",
    "HUGGINGFACE_HUB_CACHE": "${HOME}/Library/Application Support/GaryLocalhost/cache/huggingface/hub",
    "CAREY_CHECKPOINT_DIR": "${HOME}/Library/Application Support/GaryLocalhost/cache/carey/checkpoints",
    "TRANSFORMERS_CACHE": "${HOME}/Library/Application Support/GaryLocalhost/cache/huggingface/transformers",
    "TORCH_HOME": "${HOME}/Library/Application Support/GaryLocalhost/cache/torch",
    "XDG_CACHE_HOME": "${HOME}/Library/Application Support/GaryLocalhost/cache",
    "TMPDIR": "${HOME}/Library/Application Support/GaryLocalhost/tmp",
    "PYTORCH_ENABLE_MPS_FALLBACK": "1"
  },
  "default_log_directory": "${HOME}/Library/Logs/GaryLocalhost",
  "services": [
    {
      "id": "audiocraft_mlx",
      "name": "Audiocraft MLX",
      "working_directory": "${WORKSPACE_ROOT}/audiocraft-mlx/audiocraft",
      "executable": "${WORKSPACE_ROOT}/audiocraft-mlx/.venv/bin/python",
      "arguments": [
        "g4l_localhost.py"
      ],
      "environment": {
        "PYTHONUNBUFFERED": "${PYTHONUNBUFFERED}",
        "HF_HUB_DISABLE_XET": "1",
        "HF_XET_HIGH_PERFORMANCE": "0",
        "HF_XET_NUM_RANGE_IN_SEGMENT_BASE": "16",
        "G4L_HF_XET_MODE": "adaptive",
        "G4L_HF_XET_PROBE_TIMEOUT_SECONDS": "20",
        "G4L_HF_DOWNLOADER_XET_MODE": "adaptive",
        "G4L_HF_DOWNLOADER_XET_HIGH_PERFORMANCE": "1",
        "G4L_HF_DOWNLOADER_XET_NUM_CONCURRENT_RANGE_GETS": "128",
        "G4L_HF_XET_FIRST_BYTE_TIMEOUT_SECONDS": "25",
        "G4L_HF_XET_SLOW_SPEED_BPS": "1048576",
        "G4L_HF_XET_SLOW_SPEED_GRACE_SECONDS": "45",
        "G4L_HF_SNAPSHOT_MAX_WORKERS": "128",
        "PYTORCH_ENABLE_MPS_FALLBACK": "${PYTORCH_ENABLE_MPS_FALLBACK}"
      },
      "bootstrap": {
        "python_executable": "python3.11",
        "venv_directory": "${WORKSPACE_ROOT}/audiocraft-mlx/.venv",
        "requirements_file": "${WORKSPACE_ROOT}/audiocraft-mlx/audiocraft/requirements.txt",
        "upgrade_build_tools": true,
        "pip_arguments": []
      },
      "log_file": "audiocraft-mlx.log",
      "health_check": {
        "url": "http://127.0.0.1:8000/health",
        "expected_status": 200,
        "interval_seconds": 3,
        "timeout_seconds": 2
      },
      "auto_start": false,
      "restart_on_crash": true,
      "graceful_shutdown_seconds": 8
    },
    {
      "id": "carey",
      "name": "Carey (ACE Lego)",
      "working_directory": "${WORKSPACE_ROOT}/ace-lego/wrapper",
      "executable": "/bin/bash",
      "arguments": [
        "${WORKSPACE_ROOT}/ace-lego/wrapper/run_local_carey_stack.sh"
      ],
      "environment": {
        "PYTHONUNBUFFERED": "${PYTHONUNBUFFERED}",
        "CAREY_PYTHON": "${WORKSPACE_ROOT}/ace-lego/ACE-Step-1.5/.venv/bin/python",
        "CAREY_API_ROOT": "${WORKSPACE_ROOT}/ace-lego/ACE-Step-1.5",
        "CAREY_WRAPPER_ROOT": "${WORKSPACE_ROOT}/ace-lego/wrapper",
        "CAREY_API_HOST": "127.0.0.1",
        "CAREY_API_PORT": "8001",
        "ACESTEP_URL": "http://127.0.0.1:8001",
        "WRAPPER_PORT": "8003",
        "ACESTEP_BACKEND": "local",
        "ACESTEP_MANAGE_LIFECYCLE": "true",
        "ACESTEP_CONFIG_PATH": "acestep-v15-base",
        "ACESTEP_BASE_CONFIG_PATH": "acestep-v15-base",
        "ACESTEP_SFT_CONFIG_PATH": "acestep-v15-sft",
        "ACESTEP_TURBO_CONFIG_PATH": "acestep-v15-turbo",
        "ACESTEP_LEGO_CONFIG_PATH": "acestep-v15-base",
        "ACESTEP_REGULAR_CONFIG_PATH": "acestep-v15-base",
        "ACESTEP_NO_INIT": "true",
        "ACESTEP_INIT_LLM": "false",
        "ACESTEP_ALLOW_MAIN_AUTODOWNLOAD": "false",
        "ACESTEP_UNLOAD_STRATEGY": "soft",
        "ACESTEP_API_HOST": "127.0.0.1",
        "ACESTEP_API_PORT": "8001",
        "PYTORCH_ENABLE_MPS_FALLBACK": "${PYTORCH_ENABLE_MPS_FALLBACK}",
        "ACESTEP_CHECKPOINT_DIR": "${CAREY_CHECKPOINT_DIR}",
        "CAREY_LORA_REGISTRY": "${HOME}/Library/Application Support/GaryLocalhost/carey/lora_registry.json",
        "CAREY_CAPTIONS": "${HOME}/Library/Application Support/GaryLocalhost/carey/captions.json",
        "CAREY_GENERATION_TIMEOUT": "1800",
        "HF_HUB_DISABLE_XET": "1",
        "HF_XET_HIGH_PERFORMANCE": "0",
        "HF_XET_NUM_RANGE_IN_SEGMENT_BASE": "16",
        "G4L_HF_XET_MODE": "adaptive",
        "G4L_HF_XET_PROBE_TIMEOUT_SECONDS": "20",
        "G4L_HF_DOWNLOADER_XET_MODE": "adaptive",
        "G4L_HF_DOWNLOADER_XET_HIGH_PERFORMANCE": "1",
        "G4L_HF_DOWNLOADER_XET_NUM_CONCURRENT_RANGE_GETS": "128",
        "G4L_HF_XET_FIRST_BYTE_TIMEOUT_SECONDS": "25",
        "G4L_HF_XET_SLOW_SPEED_BPS": "1048576",
        "G4L_HF_XET_SLOW_SPEED_GRACE_SECONDS": "45",
        "G4L_HF_SNAPSHOT_MAX_WORKERS": "128"
      },
      "bootstrap": {
        "python_executable": "python3.11",
        "venv_directory": "${WORKSPACE_ROOT}/ace-lego/ACE-Step-1.5/.venv",
        "requirements_file": "${WORKSPACE_ROOT}/ace-lego/ACE-Step-1.5/requirements.txt",
        "upgrade_build_tools": true,
        "pip_arguments": []
      },
      "log_file": "carey.log",
      "health_check": {
        "url": "http://127.0.0.1:8003/health",
        "expected_status": 200,
        "interval_seconds": 3,
        "timeout_seconds": 2
      },
      "auto_start": false,
      "restart_on_crash": true,
      "graceful_shutdown_seconds": 8
    },
    {
      "id": "melodyflow",
      "name": "MelodyFlow",
      "working_directory": "${WORKSPACE_ROOT}/melodyflow",
      "executable": "${WORKSPACE_ROOT}/melodyflow/.venv/bin/python",
      "arguments": [
        "localhost_melodyflow.py"
      ],
      "environment": {
        "PYTHONUNBUFFERED": "${PYTHONUNBUFFERED}",
        "MELODYFLOW_REQUIRE_MPS": "1",
        "HF_HUB_DISABLE_XET": "1",
        "HF_XET_HIGH_PERFORMANCE": "0",
        "HF_XET_NUM_RANGE_IN_SEGMENT_BASE": "4",
        "G4L_HF_XET_MODE": "adaptive",
        "G4L_HF_XET_PROBE_TIMEOUT_SECONDS": "20",
        "G4L_HF_DOWNLOADER_XET_MODE": "adaptive",
        "G4L_HF_DOWNLOADER_XET_HIGH_PERFORMANCE": "1",
        "G4L_HF_DOWNLOADER_XET_NUM_CONCURRENT_RANGE_GETS": "64",
        "G4L_HF_XET_FIRST_BYTE_TIMEOUT_SECONDS": "25",
        "G4L_HF_XET_SLOW_SPEED_BPS": "1048576",
        "G4L_HF_XET_SLOW_SPEED_GRACE_SECONDS": "45",
        "G4L_HF_SNAPSHOT_MAX_WORKERS": "64"
      },
      "bootstrap": {
        "python_executable": "python3.11",
        "venv_directory": "${WORKSPACE_ROOT}/melodyflow/.venv",
        "requirements_file": "${WORKSPACE_ROOT}/melodyflow/requirements.txt",
        "upgrade_build_tools": true,
        "pip_arguments": []
      },
      "log_file": "melodyflow.log",
      "health_check": {
        "url": "http://127.0.0.1:8002/health",
        "expected_status": 200,
        "interval_seconds": 3,
        "timeout_seconds": 2
      },
      "auto_start": false,
      "restart_on_crash": true,
      "graceful_shutdown_seconds": 8
    },
    {
      "id": "sa3",
      "name": "sa3 (stable audio 3)",
      "working_directory": "${WORKSPACE_ROOT}/sa3",
      "executable": "${WORKSPACE_ROOT}/sa3/.venv/bin/python",
      "arguments": [
        "api.py"
      ],
      "environment": {
        "PYTHONUNBUFFERED": "${PYTHONUNBUFFERED}",
        "HF_HOME": "${HF_HOME}",
        "HUGGINGFACE_HUB_CACHE": "${HUGGINGFACE_HUB_CACHE}",
        "HF_HUB_DISABLE_XET": "1",
        "HF_XET_HIGH_PERFORMANCE": "0",
        "HF_XET_NUM_RANGE_IN_SEGMENT_BASE": "16",
        "G4L_HF_XET_MODE": "adaptive",
        "G4L_HF_XET_PROBE_TIMEOUT_SECONDS": "20",
        "G4L_HF_DOWNLOADER_XET_MODE": "adaptive",
        "G4L_HF_DOWNLOADER_XET_HIGH_PERFORMANCE": "1",
        "G4L_HF_DOWNLOADER_XET_NUM_CONCURRENT_RANGE_GETS": "128",
        "G4L_HF_XET_FIRST_BYTE_TIMEOUT_SECONDS": "25",
        "G4L_HF_XET_SLOW_SPEED_BPS": "1048576",
        "G4L_HF_XET_SLOW_SPEED_GRACE_SECONDS": "45",
        "G4L_HF_SNAPSHOT_MAX_WORKERS": "128",
        "PYTORCH_ENABLE_MPS_FALLBACK": "${PYTORCH_ENABLE_MPS_FALLBACK}",
        "TRANSFORMERS_CACHE": "${TRANSFORMERS_CACHE}",
        "TORCH_HOME": "${TORCH_HOME}",
        "XDG_CACHE_HOME": "${XDG_CACHE_HOME}",
        "TMPDIR": "${TMPDIR}",
        "PORT": "8006",
        "SA3_MODEL": "medium",
        "SA3_MLX_ATTENTION": "sliding",
        "SA3_MLX_DTYPE": "float16",
        "SA3_MLX_DIT_DTYPE": "float32",
        "SA3_MLX_TEXT_DTYPE": "float16",
        "SA3_MLX_NUMBER_DTYPE": "float16",
        "SA3_MLX_AUTOENCODER_DTYPE": "float16",
        "SA3_TORCH_DEVICE": "auto",
        "SA3_TORCH_MODEL_HALF": "0",
        "SA3_PROMPTS_DIR": "${HOME}/Library/Application Support/GaryLocalhost/sa3/prompts",
        "SA3_LORA_REGISTRY": "${HOME}/Library/Application Support/GaryLocalhost/sa3/lora_registry.json",
        "SA3_LORA_DIR": "${HOME}/Library/Application Support/GaryLocalhost/sa3/loras",
        "SA3_PEAK_NORMALIZE_DB": "2.0",
        "SA3_LIMITER_CEILING_DB": "-0.3",
        "SA3_LIMITER_KNEE": "0.8",
        "SA3_LATENT_RESCALE": "1.0",
        "SA3_LATENT_SHIFT": "0.0",
        "SA3_LATENT_TARGET_STD": "",
        "SA3_LATENT_ADAPT_MIN": "0.9",
        "SA3_LATENT_ADAPT_MAX": "1.0",
        "SA3_CHUNKED_DECODE": "1",
        "SA3_DECODE_CHUNK_SIZE": "128",
        "SA3_DECODE_OVERLAP": "32",
        "SA3_DECODE_CHUNK_BATCH_SIZE": "1",
        "SA3_CONTINUE_TAIL_MODE": "regen_past",
        "SA3_CONTINUE_TAIL_PAD": "6",
        "SA3_LATENT_DIAG": "0",
        "OUTPUT_DIR": "${HOME}/Library/Application Support/GaryLocalhost/sa3/outputs"
      },
      "bootstrap": {
        "python_executable": "python3.11",
        "venv_directory": "${WORKSPACE_ROOT}/sa3/.venv",
        "requirements_file": "${WORKSPACE_ROOT}/sa3/requirements.txt",
        "upgrade_build_tools": true,
        "pip_arguments": []
      },
      "log_file": "sa3.log",
      "health_check": {
        "url": "http://127.0.0.1:8006/health",
        "expected_status": 200,
        "interval_seconds": 3,
        "timeout_seconds": 2
      },
      "auto_start": false,
      "restart_on_crash": true,
      "graceful_shutdown_seconds": 8
    },
    {
      "id": "stable_audio",
      "name": "Stable Audio",
      "working_directory": "${WORKSPACE_ROOT}/stable-audio-tools",
      "executable": "${WORKSPACE_ROOT}/stable-audio-tools/.venv/bin/python",
      "arguments": [
        "api.py"
      ],
      "environment": {
        "PYTHONUNBUFFERED": "${PYTHONUNBUFFERED}",
        "HF_HUB_DISABLE_XET": "1",
        "HF_XET_HIGH_PERFORMANCE": "0",
        "HF_XET_NUM_RANGE_IN_SEGMENT_BASE": "4",
        "G4L_HF_XET_MODE": "adaptive",
        "G4L_HF_XET_PROBE_TIMEOUT_SECONDS": "20",
        "G4L_HF_DOWNLOADER_XET_MODE": "adaptive",
        "G4L_HF_DOWNLOADER_XET_HIGH_PERFORMANCE": "1",
        "G4L_HF_DOWNLOADER_XET_NUM_CONCURRENT_RANGE_GETS": "64",
        "G4L_HF_XET_FIRST_BYTE_TIMEOUT_SECONDS": "25",
        "G4L_HF_XET_SLOW_SPEED_BPS": "1048576",
        "G4L_HF_XET_SLOW_SPEED_GRACE_SECONDS": "45",
        "G4L_HF_SNAPSHOT_MAX_WORKERS": "64"
      },
      "bootstrap": {
        "python_executable": "python3.11",
        "venv_directory": "${WORKSPACE_ROOT}/stable-audio-tools/.venv",
        "requirements_file": "${WORKSPACE_ROOT}/stable-audio-tools/requirements.txt",
        "upgrade_build_tools": true,
        "pip_arguments": []
      },
      "log_file": "stable-audio.log",
      "health_check": {
        "url": "http://127.0.0.1:8005/health",
        "expected_status": 200,
        "interval_seconds": 3,
        "timeout_seconds": 2
      },
      "auto_start": false,
      "restart_on_crash": true,
      "graceful_shutdown_seconds": 8
    },
    {
      "id": "foundation",
      "name": "foundation-1",
      "working_directory": "${WORKSPACE_ROOT}/foundation",
      "executable": "${WORKSPACE_ROOT}/foundation/.venv/bin/python",
      "arguments": [
        "api_foundation.py"
      ],
      "environment": {
        "PYTHONUNBUFFERED": "${PYTHONUNBUFFERED}",
        "FOUNDATION_SAOMLX_ROOT": "${WORKSPACE_ROOT}/stable-audio-tools",
        "FOUNDATION_MODEL_DIR": "${HOME}/Library/Application Support/GaryLocalhost/cache/foundation-1",
        "PORT": "8015",
        "PYTORCH_ENABLE_MPS_FALLBACK": "${PYTORCH_ENABLE_MPS_FALLBACK}",
        "HF_HUB_DISABLE_XET": "1",
        "HF_XET_HIGH_PERFORMANCE": "0",
        "G4L_HF_XET_MODE": "adaptive",
        "G4L_HF_XET_PROBE_TIMEOUT_SECONDS": "20",
        "G4L_HF_DOWNLOADER_XET_MODE": "adaptive",
        "G4L_HF_DOWNLOADER_XET_HIGH_PERFORMANCE": "1",
        "G4L_HF_DOWNLOADER_XET_NUM_CONCURRENT_RANGE_GETS": "64",
        "G4L_HF_XET_FIRST_BYTE_TIMEOUT_SECONDS": "25",
        "G4L_HF_XET_SLOW_SPEED_BPS": "1048576",
        "G4L_HF_XET_SLOW_SPEED_GRACE_SECONDS": "45",
        "G4L_HF_SNAPSHOT_MAX_WORKERS": "64"
      },
      "bootstrap": {
        "python_executable": "python3.11",
        "venv_directory": "${WORKSPACE_ROOT}/foundation/.venv",
        "requirements_file": "${WORKSPACE_ROOT}/foundation/requirements.txt",
        "upgrade_build_tools": true,
        "pip_arguments": []
      },
      "log_file": "foundation.log",
      "health_check": {
        "url": "http://127.0.0.1:8015/health",
        "expected_status": 200,
        "interval_seconds": 3,
        "timeout_seconds": 2
      },
      "auto_start": false,
      "restart_on_crash": true,
      "graceful_shutdown_seconds": 8
    }
  ]
}
